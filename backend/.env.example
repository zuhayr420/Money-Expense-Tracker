# Flask Core Configuration
SECRET_KEY=generate-a-strong-random-hex-string-for-production
JWT_SECRET_KEY=generate-a-strong-random-jwt-secret-for-production
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Database Configuration
# For local SQLite: sqlite:///family_finance.db
# For production PostgreSQL (Render/Supabase/Neon/Railway): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///family_finance.db

# CORS Allowed Origins (Comma-separated list of frontends, or * if open)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
